  falasDialogo:
  - identificador: "[Stella] : Quem est\xE1 a\xED?"
    ator: {fileID: 11400000, guid: 5dbc56b8fcf4c994a8c69c34beef2d79, type: 2}
    texto: "Quem est\xE1 a\xED?"
  - identificador: "[CUIDADO!] : N\xE3o tema... Sou apenas aquela que todos um dia
      encontram."
    ator: {fileID: 11400000, guid: c3828b39c4fa18b489569b2f9dcaa27f, type: 2}
    texto: "N\xE3o tema... Sou apenas aquela que todos um dia encontram."
  - identificador: "[Stella] :  Eu ainda n\xE3o terminei minha jornada."
    ator: {fileID: 11400000, guid: 5dbc56b8fcf4c994a8c69c34beef2d79, type: 2}
    texto: " Eu ainda n\xE3o terminei minha jornada."
  - identificador: "[CUIDADO!] : Quase ningu\xE9m termina.\nMas alguns... pulam mesmo
      assim"
    ator: {fileID: 11400000, guid: c3828b39c4fa18b489569b2f9dcaa27f, type: 2}
    texto: "Quase ningu\xE9m termina.\nMas alguns... pulam mesmo assim"
  - identificador: "[Stella] : Isso \xE9 um fim?"
    ator: {fileID: 11400000, guid: 5dbc56b8fcf4c994a8c69c34beef2d79, type: 2}
    texto: "Isso \xE9 um fim?"
  - identificador: "[CUIDADO!] : Depende.\nAlguns chamam de fim.\nOutros, de recome\xE7o.\nE
      poucos... de liberta\xE7\xE3o."
    ator: {fileID: 11400000, guid: c3828b39c4fa18b489569b2f9dcaa27f, type: 2}
    texto: "Depende.\nAlguns chamam de fim.\nOutros, de recome\xE7o.\nE poucos...
      de liberta\xE7\xE3o."
  - identificador: "[CUIDADO!] : Depende.\nAlguns chamam de fim.\nOutros, de recome\xE7o.\nE
      poucos... de liberta\xE7\xE3o."
    ator: {fileID: 11400000, guid: c3828b39c4fa18b489569b2f9dcaa27f, type: 2}
    texto: "Depende.\nAlguns chamam de fim.\nOutros, de recome\xE7o.\nE poucos...
      de liberta\xE7\xE3o."
  - identificador: "[CUIDADO!] : O ch\xE3o n\xE3o est\xE1 \xE0 sua espera. Mas algo
      mais profundo\u2026 est\xE1."
    ator: {fileID: 11400000, guid: c3828b39c4fa18b489569b2f9dcaa27f, type: 2}
    texto: "O ch\xE3o n\xE3o est\xE1 \xE0 sua espera. Mas algo mais profundo\u2026
      est\xE1."
